# syntax=docker/dockerfile:1
# Pantry Tracker MCP server — a thin Streamable HTTP wrapper over the REST API
# (mcp/). Runs as its own container next to the app; reaches the pantry over the
# compose network and exposes MCP tools to a LAN agent (Hermes).
FROM node:22-bookworm-slim
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /app

# Install deps. --ignore-scripts skips the better-sqlite3 native build (this
# process never loads it — it only speaks HTTP); --prod=false keeps tsx, which
# runs the TypeScript entrypoint directly.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
  pnpm install --frozen-lockfile --prod=false --ignore-scripts

# Source: the MCP server + tsconfig (tsx honours the @/* path alias from it).
COPY tsconfig.json ./
COPY mcp ./mcp

ENV NODE_ENV=production
EXPOSE 3001
CMD ["pnpm", "mcp"]
