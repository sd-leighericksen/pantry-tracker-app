# Database — SQLite file path. Dev defaults to ./data/pantry.sqlite.
# In Docker this lives on a mounted volume at /data/pantry.sqlite.
DB_PATH=./data/pantry.sqlite

# Auth — long session secret (256-bit). Generate with: openssl rand -hex 32
AUTH_SESSION_SECRET=replace-me

# Open Food Facts — required User-Agent per OFF API guidelines.
# Format: AppName/Version (contact)
OFF_USER_AGENT="PantryTracker/0.1 (leigh@stokedesign.co)"

# OpenRouter — server-side only, never exposed to client.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_TEXT_MODEL=anthropic/claude-3.5-haiku

# Public base URL — used for webhook payloads and PWA manifest.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment (docker-compose) — public hostname for Caddy + automatic TLS.
# Leave as localhost for a local run (Caddy issues a self-signed cert).
DOMAIN=localhost

# MCP server (mcp/) — Streamable HTTP wrapper over the REST API for LAN agents.
# Device token minted in Settings → Device & API tokens (kind "api"). Required.
PANTRY_API_TOKEN=
# Optional shared secret the agent must send as `Authorization: Bearer <token>`.
# Generate with: openssl rand -hex 32. Leave blank only on a trusted LAN.
MCP_AUTH_TOKEN=
